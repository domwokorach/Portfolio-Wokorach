# Frontend (Vite)
# Local backend example:
VITE_MAIL_API_URL=http://127.0.0.1:3000/api/mail
# Production example:
# VITE_MAIL_API_URL=https://your-api-domain.com/api/mail
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key

# Backend mail API (Node server)
MAIL_API_HOST=0.0.0.0
PORT=3000
NODE_ENV=development
MAIL_PRIVACY_MODE=true

# Incoming mail (IMAP)
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true

# Outgoing mail (SMTP)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_or_provider_password
MAIL_FROM=your_email@gmail.com

# Google OAuth2 variables (used by /auth/google, /oauth2callback, /emails)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token