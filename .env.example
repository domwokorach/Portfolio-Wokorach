# Frontend variables used by the Vite app
VITE_MAIL_API_URL=http://127.0.0.1:3001/api/mail
# Local direct API example:
VITE_MAIL_API_URL=http://127.0.0.1:3001/api/mail
# Production example (Vercel -> Railway API):

VITE_MAIL_API_URL=https://portfolio-wokorach-production.up.railway.app/api/mail
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_embed_api_key

# Backend mail variables for an IMAP/Nodemailer service
# Bind host (use 0.0.0.0 in cloud environments like Railway)
MAIL_API_HOST=0.0.0.0
# Optional local override only; Railway provides PORT automatically
# MAIL_API_PORT=3001

MAIL_IMAP_HOST=outlook.office365.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=smtp-mail.outlook.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_USER=your_email@outlook.com
MAIL_PASS=your_password_or_app_password
MAIL_FROM=your_email@outlook.com

# Optional Gmail OAuth2 variables (used by /auth/google, /oauth2callback, /emails)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/oauth2callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token